// A calculator with dates. Numbers, dates and durations are semantic types (DateCalcLanguage.cs);
// each operator and call lowers to the catalog operation its operand types select, so `date + duration`
// and `date - date` type-check, lower to HIR and run, while `date + date` is a source diagnostic.
// Functions and constants come from two modules: Math (MathModule.cs) and DateCalc's own.
syntax module DateCalc
{
  symbols { value function }
  symbol property Type for value : Nitrogen.Semantic.SemanticType? = DateCalcLanguage.Builtin(name);
  symbol property Initializer for value : int? = null;

  token Digit      = ['0'..'9'];
  token Date       = Digit Digit Digit Digit "-" Digit Digit "-" Digit Digit;
  token Number     = Digit+ ("." Digit+)?;
  token Identifier = ['a'..'z' 'A'..'Z' '_'] ['a'..'z' 'A'..'Z' '0'..'9' '_']* except "let" "days" "weeks" "in";

  builtin value { pi e tau }
  builtin function
  {
    abs sign sqrt cbrt exp ln log10 log2 sin cos tan asin acos atan sinh cosh tanh
    floor ceil trunc round pow log atan2 min max mod weekday
  }

  syntax Program   = Statements:Statement*;
  syntax Statement = Let / Show;
  syntax Let       = "let" Name:Identifier "=" Value:Expr ";"  declares value Name sequential
  { symbol.Type = Value.Type; symbol.Initializer = Value.Node; }
  syntax Show      = Value:Expr ";";

  extensible syntax Expr
  {
    out hover Type : Nitrogen.Semantic.SemanticType? = null;
    out Selected : Nitrogen.Semantic.OperationSignature? = null;
    out Source : int? = null;

    | Day     = Value:Date  lowers DateCalc.Date(text Value)
      {
        Type = DateCalcLanguage.Date;
        check DC0001 DateCalcLanguage.IsDate(Value.Text) : $"'{Value.Text}' is not a calendar date";
      }
    | Num     = Value:Number  lowers literal Core.Scalar Value  { Type = DateCalcLanguage.Number; }
    | Ref     = Name:Identifier  references value Name  lowers reference type Type initializer Source
      { Type = Symbol?.Type; Source = Symbol?.Initializer; }
    | Paren   = "(" Inner:Expr ")"  { Type = Inner.Type; }
    | Call    = Function:Identifier "(" Arg:Expr ")"  references function Function  lowers operation? Selected(Arg)
      {
        Selected = DateCalcLanguage.Call(Function.Text, Arg.Type);
        Type = Selected?.Result;
        check DC0003 Symbol is null || DateCalcLanguage.Fits(Selected, Arg.Type) : DateCalcLanguage.NoCall(Function.Text, Arg.Type);
      }
    | Call2   = Function:Identifier "(" Left:Expr "," Right:Expr ")"  references function Function  lowers operation? Selected(Left, Right)
      {
        Selected = DateCalcLanguage.Call(Function.Text, Left.Type, Right.Type);
        Type = Selected?.Result;
        check DC0003 Symbol is null || DateCalcLanguage.Fits(Selected, Left.Type, Right.Type) : DateCalcLanguage.NoCall(Function.Text, Left.Type, Right.Type);
      }
    | Days    = Amount:Expr "days"  precedence 30  lowers DateCalc.Days(Amount)  { Type = DateCalcLanguage.Duration; }
    | Weeks   = Amount:Expr "weeks" precedence 30  lowers DateCalc.Weeks(Amount) { Type = DateCalcLanguage.Duration; }
    | InDays  = Span:Expr "in" "days"  precedence 5  lowers DateCalc.InDays(Span)  { Type = DateCalcLanguage.Number; }
    | Add     = Left:Expr "+" Right:Expr  precedence 10 left  lowers operation? Selected(Left, Right)
      {
        Selected = DateCalcLanguage.Select("+", Left.Type, Right.Type);
        Type = Selected?.Result;
        check DC0002 DateCalcLanguage.Fits(Selected, Left.Type, Right.Type) : DateCalcLanguage.Mismatch("+", Left.Type, Right.Type);
      }
    | Sub     = Left:Expr "-" Right:Expr  precedence 10 left  lowers operation? Selected(Left, Right)
      {
        Selected = DateCalcLanguage.Select("-", Left.Type, Right.Type);
        Type = Selected?.Result;
        check DC0002 DateCalcLanguage.Fits(Selected, Left.Type, Right.Type) : DateCalcLanguage.Mismatch("-", Left.Type, Right.Type);
      }
    | Mul     = Left:Expr "*" Right:Expr  precedence 20 left  lowers operation? Selected(Left, Right)
      {
        Selected = DateCalcLanguage.Select("*", Left.Type, Right.Type);
        Type = Selected?.Result;
        check DC0002 DateCalcLanguage.Fits(Selected, Left.Type, Right.Type) : DateCalcLanguage.Mismatch("*", Left.Type, Right.Type);
      }
    | Div     = Left:Expr "/" Right:Expr  precedence 20 left  lowers operation? Selected(Left, Right)
      {
        Selected = DateCalcLanguage.Select("/", Left.Type, Right.Type);
        Type = Selected?.Result;
        check DC0002 DateCalcLanguage.Fits(Selected, Left.Type, Right.Type) : DateCalcLanguage.Mismatch("/", Left.Type, Right.Type);
      }
  }
}
