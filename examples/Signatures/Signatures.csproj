<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <UseNitrogenPackage Condition="'$(UseNitrogenPackage)' == ''">false</UseNitrogenPackage>
        <_NitrogenChecker Condition="'$(UseNitrogenPackage)' != 'true'">$(MSBuildThisFileDirectory)../../Nitrogen.Cli/bin/$(Configuration)/net10.0/nitrogen.dll</_NitrogenChecker>
        <_NitrogenTaskAssembly Condition="'$(UseNitrogenPackage)' != 'true'">$(MSBuildThisFileDirectory)../../Nitrogen.Build/bin/$(Configuration)/net10.0/Nitrogen.Build.dll</_NitrogenTaskAssembly>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Nitrogen.Build" Version="$(VersionPrefix)" Condition="'$(UseNitrogenPackage)' == 'true'" />
        <NitrogenInput Include="../DateCalc/DateCalc.ngr" />
        <Compile
            Include="../DateCalc/DateCalcLanguage.cs;../DateCalc/MathModule.cs;../DateCalc/DateCalcEvaluator.cs;../DateCalc/DateCalcFixes.cs" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseNitrogenPackage)' != 'true'">
        <ProjectReference Include="../../Nitrogen.Runtime/Nitrogen.Runtime.csproj" />
        <ProjectReference Include="../../Nitrogen.Generator/Nitrogen.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="../../Nitrogen.Build/Nitrogen.Build.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="../../Nitrogen.Cli/Nitrogen.Cli.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>
    <Import Project="../../Nitrogen.Build/build/Nitrogen.Build.props" Condition="'$(UseNitrogenPackage)' != 'true'" />
    <Import Project="../../Nitrogen.Build/build/Nitrogen.Build.targets" Condition="'$(UseNitrogenPackage)' != 'true'" />
</Project>
