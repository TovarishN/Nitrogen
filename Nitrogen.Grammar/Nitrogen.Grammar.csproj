<Project Sdk="Microsoft.NET.Sdk">

  <!--
    netstandard2.0 because Plan 3's Roslyn source generator loads this assembly, and generators
    must target netstandard2.0. Keep it free of package dependencies.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Nitrogen.Grammar</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Nitrogen.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
