<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One self-contained analyzer assembly: the grammar library's sources are compiled in rather than
    referenced, because an analyzer's own dependencies are not loaded from a ProjectReference.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);RS1017;RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Nitrogen.Grammar\*.cs" Link="Grammar\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
