syntax module QuoteHelpers
{
    token Number = ['0'..'9']+;
    syntax function Twice(Input: Expr*) : Expr = <[ f(..$Input, ..$Input) ]>;
    syntax function Multiply(Value: Expr) : Expr = <[ $Value * 2 ]>;
    syntax function Need(Input: Expr*) : Expr = <[ required(..$Input) ]>;
    syntax function Pair(A: Expr, B: Expr) : Expr = <[ $A + $B ]>;
    syntax function Cycle(Value: Expr) : Expr = <[ $Value cycle ]>;
    extensible syntax Expr
    {
        | Paren = "(" Inner:Expr ")"
        | Num = Value:Number lowers literal Core.Scalar Value
        | Add = Left:Expr "+" Right:Expr precedence 10 left lowers Test.Add(Left, Right)
        | Mul = Left:Expr "*" Right:Expr precedence 20 left lowers Test.Mul(Left, Right)
        | Call = "f" "(" Args:(Expr; ",")* ")" lowers Test.Call(sequence Core.Scalar Args)
        | Required = "required" "(" Args:(Expr; ",")+ ")" lowers Test.Call(sequence Core.Scalar Args)
        | Forward = "twice" "(" Args:(Expr; ";")* ")" rewrites Twice(Args)
        | Times = Inner:Expr "times" precedence 30 rewrites Multiply(Inner)
        | Needs = "need" "(" Args:(Expr; ";")* ")" rewrites Need(Args)
        | Duplicate = Inner:Expr "duplicate" precedence 30 rewrites Pair(Inner, Inner)
        | Cyclic = Inner:Expr "cycle" precedence 30 rewrites Cycle(Inner)
    }
}
