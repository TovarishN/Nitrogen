// Deliberately limited C# 4 declaration fixture, not a C# language implementation.
syntax module RecoveryCSharp
{
  token Name = ['a'..'z' 'A'..'Z' '_'] ['a'..'z' 'A'..'Z' '0'..'9' '_']* except "class" "int" "object";
  syntax File = Classes:Class*;
  syntax Class = "class" Name "{" Members:Field* "}";
  syntax Field = Type Name ";";
  syntax Type = "int" / "object" / Name;
}
