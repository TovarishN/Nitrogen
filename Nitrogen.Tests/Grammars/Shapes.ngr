// Tree shapes (compact trees): absent optionals and empty lists are null child slots. Anon and
// Want bind through an optional name, which may be a null slot.
syntax module Shapes
{
  symbols { value }

  token Name = ['a'..'z']+ except "decl" "int" "public" "static" "anon" "want";
  syntax File = Decls:Decl*;
  syntax Decl = Mods:Mod* "decl" Name:Name Type:(":" TypeName)? "{" Items:(Name; ",")* "}";
  syntax Mod = "public" / "static";
  syntax TypeName = "int" / Name;
  syntax Anon = "anon" Name:Name? ";" declares value Name;
  syntax Want = "want" Target:Name? ";" references value Target;
}
