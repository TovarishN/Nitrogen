<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nitrogen.Runtime\Nitrogen.Runtime.csproj" />
    <ProjectReference Include="..\Nitrogen.Grammar\Nitrogen.Grammar.csproj" />
    <ProjectReference Include="..\Nitrogen.Ngr\Nitrogen.Ngr.csproj" />
    <ProjectReference Include="..\Nitrogen.Geometry\Nitrogen.Geometry.csproj" />
    <ProjectReference Include="..\Nitrogen.Workspace\Nitrogen.Workspace.csproj" />
    <ProjectReference Include="..\Nitrogen.Cli\Nitrogen.Cli.csproj" />
    <ProjectReference Include="..\Nitrogen.LanguageService\Nitrogen.LanguageService.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Grammars\**\*.ngr" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Nitrogen.Ngr\Nitrogen.ngr" Link="Grammars\Nitrogen.ngr" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The runtime tests run against modules generated from these grammars. -->
  <ItemGroup>
    <ProjectReference Include="..\Nitrogen.Generator\Nitrogen.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="Grammars\Calc.ngr" Namespace="Nitrogen.Tests.Calc" />
    <AdditionalFiles Include="Grammars\Power.ngr" Namespace="Nitrogen.Tests.Calc" />
    <AdditionalFiles Include="Grammars\Clash.ngr" Namespace="Nitrogen.Tests.Calc" />
    <AdditionalFiles Include="Grammars\Mini.ngr" Namespace="Nitrogen.Tests.Mini" />
    <AdditionalFiles Include="Grammars\Lexical.ngr" Namespace="Nitrogen.Tests.Lexical" />
    <AdditionalFiles Include="Grammars\Recovery.ngr" Namespace="Nitrogen.Tests.Recovery" />
    <AdditionalFiles Include="Grammars\Lists.ngr" Namespace="Nitrogen.Tests.Lists" />
    <AdditionalFiles Include="Grammars\Base.ngr" Namespace="Nitrogen.Tests.Base" />
    <AdditionalFiles Include="Grammars\Uses.ngr" Namespace="Nitrogen.Tests.Uses" />
    <AdditionalFiles Include="Grammars\Scopes.ngr" Namespace="Nitrogen.Tests.Scopes" />
    <AdditionalFiles Include="Grammars\Typed.ngr" Namespace="Nitrogen.Tests.Typed" />
    <AdditionalFiles Include="Grammars\TypedExtra.ngr" Namespace="Nitrogen.Tests.Typed.Extra" />
    <AdditionalFiles Include="Grammars\Lowered.ngr" Namespace="Nitrogen.Tests.Lowered" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="Namespace" />
    <CompilerVisibleProperty Include="RootNamespace" />
  </ItemGroup>

</Project>
