<Project Sdk="Microsoft.NET.Sdk">

  <!-- The `nitrogen` command (issue 236): parse and watch samples against .ngr grammars compiled in-process. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>nitrogen</AssemblyName>
    <RootNamespace>Nitrogen.Cli</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nitrogen</ToolCommandName>
    <PackageId>Nitrogen.Cli</PackageId>
    <Description>The nitrogen command: parse and watch against .ngr grammars, the language server (nitrogen lsp), and editor plugin generation and packaging.</Description>
    <!-- Workspace grammars compile with Roslyn, which references assemblies by file path. A single-file
         publish (a bundled Rider server) must extract its assemblies so those paths exist. -->
    <IncludeAllContentForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nitrogen.Workspace\Nitrogen.Workspace.csproj" />
    <ProjectReference Include="..\Nitrogen.LanguageService\Nitrogen.LanguageService.csproj" />
    <ProjectReference Include="..\Nitrogen.Ngr\Nitrogen.Ngr.csproj" />
  </ItemGroup>

  <!-- `generate vscode` builds on the checked-in extension's dependencies, lock, and TypeScript settings. -->
  <ItemGroup>
    <EmbeddedResource Include="..\editors\vscode\package.json" LogicalName="vscode/package.json" />
    <EmbeddedResource Include="..\editors\vscode\package-lock.json" LogicalName="vscode/package-lock.json" />
    <EmbeddedResource Include="..\editors\vscode\tsconfig.json" LogicalName="vscode/tsconfig.json" />
    <EmbeddedResource Include="..\editors\vscode\src\csharpStrings.ts" LogicalName="vscode/csharpStrings.ts" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Nitrogen.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
