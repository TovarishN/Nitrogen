<Project Sdk="Microsoft.NET.Sdk">

  <!-- The IDE surface (issue 238): a pure language-service API over Nitrogen trees and binding, and an LSP server. -->
  <PropertyGroup>
    <RootNamespace>Nitrogen.LanguageService</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep built-in navigation available in installed/published servers without a repository checkout. -->
    <EmbeddedResource Include="../Nitrogen.Runtime/Semantic/SemanticType.cs" LogicalName="Navigation.SemanticType.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nitrogen.Runtime\Nitrogen.Runtime.csproj" />
    <ProjectReference Include="..\Nitrogen.Workspace\Nitrogen.Workspace.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Nitrogen.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- Gravity's MotionDSL adapter tests (Gravity issue 251). -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Nitrogen.MotionDsl.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
