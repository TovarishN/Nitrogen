{
  "name": "nitrogen",
  "displayName": "Nitrogen DSL",
  "description": ".ngr grammars and nitrogen.json workspace languages through nitrogen lsp.",
  "version": "0.18.1",
  "publisher": "nitrogen",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:ngr",
    "workspaceContains:nitrogen.json",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      { "command": "nitrogen.extractQuoteHelper", "title": "Nitrogen: Extract Quote Helper\u2026" },
      {
        "command": "nitrogen.extractGrammar",
        "title": "Nitrogen: Extract Block\u2026"
      },
      {
        "command": "nitrogen.applyGrammarExtraction",
        "title": "Nitrogen: Apply all extraction changes",
        "icon": "$(check)",
        "enablement": "nitrogen.extractionReviewPending"
      },
      {
        "command": "nitrogen.cancelGrammarExtraction",
        "title": "Nitrogen: Cancel extraction",
        "icon": "$(close)",
        "enablement": "nitrogen.extractionReviewPending"
      }
    ],
    "languages": [
      {
        "id": "ngr",
        "aliases": [
          "Nitrogen grammar"
        ],
        "extensions": [
          ".ngr"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "nitrogen-signature",
        "aliases": [
          "Nitrogen signed program"
        ]
      }
    ],
    "grammars": [
      {
        "language": "ngr",
        "scopeName": "source.ngr",
        "path": "./syntaxes/ngr.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Nitrogen",
      "properties": {
        "nitrogen.server.path": {
          "type": "string",
          "default": "",
          "description": "The nitrogen executable (runs `nitrogen lsp`); empty runs the server bundled with the extension."
        },
        "nitrogen.dotnetPath": {
          "type": "string",
          "default": "",
          "description": "The dotnet executable that runs the bundled server; empty finds it through DOTNET_ROOT, the standard install locations, and PATH."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "nitrogen.applyGrammarExtraction",
          "when": "nitrogen.extractionReviewPending",
          "group": "navigation@1"
        },
        {
          "command": "nitrogen.cancelGrammarExtraction",
          "when": "nitrogen.extractionReviewPending",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./ --noEmit && esbuild src/extension.ts --bundle --platform=node --target=node20 --format=cjs --external:vscode --sourcemap --outfile=out/extension.js",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "test": "esbuild src/csharpStrings.test.ts src/otherExtensions.test.ts src/server.test.ts src/developmentConfig.test.ts src/signatureDocuments.test.ts src/signatureRouting.test.ts src/extractGrammar.test.ts src/extractionReview.test.ts --external:vscode --bundle --platform=node --target=node20 --format=cjs --outdir=out/test && node --test out/test/csharpStrings.test.js out/test/otherExtensions.test.js out/test/server.test.js out/test/developmentConfig.test.js out/test/signatureDocuments.test.js out/test/signatureRouting.test.js out/test/extractGrammar.test.js out/test/extractionReview.test.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.0"
  }
}
