{
  "name": "nitrogen",
  "displayName": "Nitrogen DSL",
  "description": ".ngr grammars and nitrogen.json workspace languages through nitrogen lsp.",
  "version": "0.18.1",
  "publisher": "nitrogen",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:ngr",
    "workspaceContains:nitrogen.json",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "nitrogen.extractQuoteHelper",
        "title": "Nitrogen: Extract Quote Helper…"
      },
      {
        "command": "nitrogen.extractGrammar",
        "title": "Nitrogen: Extract Block…"
      },
      {
        "command": "nitrogen.applyGrammarExtraction",
        "title": "Nitrogen: Apply all extraction changes",
        "icon": "$(check)",
        "enablement": "nitrogen.extractionReviewPending"
      },
      {
        "command": "nitrogen.cancelGrammarExtraction",
        "title": "Nitrogen: Cancel extraction",
        "icon": "$(close)",
        "enablement": "nitrogen.extractionReviewPending"
      }
    ],
    "languages": [
      {
        "id": "ngr",
        "aliases": [
          "Nitrogen grammar"
        ],
        "extensions": [
          ".ngr"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "nitrogen-signature",
        "aliases": [
          "Nitrogen signed program"
        ]
      }
    ],
    "grammars": [
      {
        "language": "ngr",
        "scopeName": "source.ngr",
        "path": "./syntaxes/ngr.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Nitrogen",
      "properties": {
        "nitrogen.server.path": {
          "type": "string",
          "default": "",
          "description": "The nitrogen executable (runs `nitrogen lsp`); empty runs the server bundled with the extension."
        },
        "nitrogen.dotnetPath": {
          "type": "string",
          "default": "",
          "description": "The dotnet executable that runs the bundled server; empty finds it through DOTNET_ROOT, the standard install locations, and PATH."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "nitrogen.applyGrammarExtraction",
          "when": "nitrogen.extractionReviewPending",
          "group": "navigation@1"
        },
        {
          "command": "nitrogen.cancelGrammarExtraction",
          "when": "nitrogen.extractionReviewPending",
          "group": "navigation@2"
        }
      ]
    },
    "semanticTokenTypes": [
      {
        "id": "operationWord",
        "description": "entity.name.function"
      },
      {
        "id": "declarationKeyword",
        "description": "storage.type"
      },
      {
        "id": "sectionKeyword",
        "description": "keyword.other"
      },
      {
        "id": "modifierWord",
        "description": "keyword.operator.word"
      },
      {
        "id": "constantWord",
        "description": "constant.language"
      },
      {
        "id": "blockBracket",
        "description": "punctuation.section.block"
      },
      {
        "id": "parenthesis",
        "description": "punctuation.section.parens"
      },
      {
        "id": "squareBracket",
        "description": "punctuation.section.brackets"
      },
      {
        "id": "terminator",
        "description": "punctuation.terminator"
      },
      {
        "id": "separator",
        "description": "punctuation.separator"
      },
      {
        "id": "operator",
        "description": "keyword.operator"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "operationWord": [
            "entity.name.function"
          ],
          "declarationKeyword": [
            "storage.type"
          ],
          "sectionKeyword": [
            "keyword.other"
          ],
          "modifierWord": [
            "keyword.operator.word"
          ],
          "constantWord": [
            "constant.language"
          ],
          "blockBracket": [
            "punctuation.section.block"
          ],
          "parenthesis": [
            "punctuation.section.parens"
          ],
          "squareBracket": [
            "punctuation.section.brackets"
          ],
          "terminator": [
            "punctuation.terminator"
          ],
          "separator": [
            "punctuation.separator"
          ],
          "operator": [
            "keyword.operator"
          ]
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./ --noEmit && esbuild src/extension.ts --bundle --platform=node --target=node20 --format=cjs --external:vscode --sourcemap --outfile=out/extension.js",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "test": "esbuild src/csharpStrings.test.ts src/otherExtensions.test.ts src/server.test.ts src/developmentConfig.test.ts src/signatureDocuments.test.ts src/signatureRouting.test.ts src/extractGrammar.test.ts src/extractionReview.test.ts src/textmate.test.ts --external:vscode --external:vscode-oniguruma --external:vscode-textmate --bundle --platform=node --target=node20 --format=cjs --outdir=out/test && node --test out/test/csharpStrings.test.js out/test/otherExtensions.test.js out/test/server.test.js out/test/developmentConfig.test.js out/test/signatureDocuments.test.js out/test/signatureRouting.test.js out/test/extractGrammar.test.js out/test/extractionReview.test.js out/test/textmate.test.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  }
}
