{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "datecalc",
  "scopeName": "source.datecalc",
  "patterns": [
    {"name":"comment.line.double-slash.datecalc","match":"//.*$"},
    {"name":"comment.block.datecalc","begin":"/\\*","end":"\\*/"},
    {"name":"constant.numeric.datecalc","match":"\\b[0-9]\\b"},
    {"name":"constant.numeric.datecalc","match":"\\b(?:(?:[0-9]))+(?:\\.(?:(?:[0-9]))+)?\\b"},
    {"name":"string.quoted.double.datecalc","begin":"\"","end":"\"","patterns":[{"match":"\\\\."}]},
    {"match":"\\b(let)\\s+([a-zA-Z_](?:[a-zA-Z0-9_])*)","captures":{"1":{"name":"storage.type.datecalc"},"2":{"name":"variable.other.readwrite.datecalc"}}},
    {"name":"entity.name.function.datecalc","match":"\\b(?:weeks|days|in)\\b"},
    {"name":"storage.type.datecalc","match":"\\b(?:let)\\b"},
    {"name":"keyword.operator.word.datecalc","match":"\\b(?:fortnights|swapped)\\b"},
    {"name":"punctuation.section.parens.datecalc","match":"\\(|\\)"},
    {"name":"punctuation.terminator.datecalc","match":";"},
    {"name":"punctuation.separator.datecalc","match":","},
    {"name":"keyword.operator.datecalc","match":"\\*|\\+|-|\\/|="}
  ]
}
