// MotionDSL's body / behavior / motion / skill language (issue 234, Plans 5 and 6). Policy and
// compose: Plan 7. Mirrors Gravity.MotionDSL's MotionLexer + MotionParser; MotionEquivalenceTests
// and SkillEquivalenceTests hold the two to the same AST on every .motion and .skill file.
syntax module Motion
{
  token Digits  = ['0'..'9']+;
  token Number  = Digits ("." Digits)? (['e' 'E'] ['+' '-']? Digits)?;
  token IdStart = ['a'..'z' 'A'..'Z' '_'];
  token IdPart  = ['a'..'z' 'A'..'Z' '0'..'9' '_'];
  token Word    = IdStart IdPart*;
  token String  = "\"" [^ '"']* "\"";

  // Every word MotionLexer turns into a keyword token.
  token Identifier = IdStart IdPart* except
    "body" "part" "joint" "let" "behavior" "reward" "done" "when" "model" "motion" "at" "pose"
    "hold" "repeat" "for" "in" "inherit" "or" "and" "not" "as" "motor" "spring" "mass" "color"
    "axis" "range" "torque" "force" "speed" "length" "hertz" "damping" "anchor" "anchor_self"
    "linear_speed" "angular_axis" "kp" "kd" "max_speed" "rot" "motor_bindings"
    "skill" "lifecycle" "finite" "looping" "continuous" "duration" "period" "fade_in" "fade_out"
    "arguments" "inputs" "float" "bool" "enum" "requires" "motors" "source" "tracks" "track"
    "from" "phases" "phase" "transition" "delay" "override" "root_position_offset"
    "root_rotation_offset" "rest" "to" "during" "easing" "release" "persistent" "paused" "mpc"
    "nested" "blend" "input" "argument" "output" "priority" "weighted" "additive"
    "parameter_weighted" "weight" "complete" "timeout" "then" "fail" "target_angle"
    "angle_offset" "feedforward_torque" "max_torque" "true" "false" "deg" "s";

  // Binding (issue 237). Motion binds within a file: nothing is exported. The hand compiler resolves
  // nested skills in the file's own library and inherit against the file's earlier behaviors.
  // Built-ins are scoped to where they mean something: observations, functions and easings to
  // skills; reward terms, axes and subjects to behaviors.
  symbols { body behavior skill part motor source phase value function reward axis subject easing }
  builtin value in Skill { both_feet_supported torso.upright torso.height time com.offset_x com.offset_z
                     torso.lean_x torso.lean_z com.velocity_x com.velocity_z }
  builtin function in Skill { abs min max clamp sin cos smoothstep }
  builtin reward in Behavior { upright alive stillness energy smoothness forward_vel height contact
                     velocity_match foot_clearance gait_symmetry pose_deviation }
  builtin axis in Behavior { x y z }
  // The subjects behaviors name in reward arguments and done conditions besides declared parts. The
  // compiler stores them unchecked (RewardTerm/DoneCondition.PartRef) and the runtime never reads them.
  builtin subject in Behavior { torso com target }
  builtin easing in Skill { linear smoothstep cubic_in cubic_out }

  // Typing (issue 239). A symbol's type is set by its declaration; built-ins, parts, rewards, axes and
  // subjects take MotionTypes.Builtin. Section says which part of a skill declared a value.
  symbol property Type for (value | part | reward | axis | subject) : SkillType = MotionTypes.Builtin(kind, name);
  symbol property Section for value : string? = null;

  syntax File          = Blocks:Block*;
  syntax Block         = Body / Behavior / MotionBlock / Skill;

  // ---- body ----
  syntax Body          = "body" Name:Identifier "{" Variables:Let* Bindings:MotorBindings? Root:Part "}"  declares body Name;
  syntax Let           = "let" Name:Identifier "=" Value:Expr  declares value Name { symbol.Type = Value.Type; }
  syntax MotorBindings = "motor_bindings" "{" Bindings:Binding* "}";
  syntax Binding       = Slot:(Identifier; ".")+ "=" Target:PartName;

  syntax Part          = "part" Name:PartName Shape:Shape Attributes:PartAttribute* Contents:PartBody?  declares part Name;
  syntax PartName      = Interpolation / PlainName;
  syntax Interpolation = "$" "{" Var:Identifier "}" Tail:Identifier?  dynamic;
  syntax PlainName     = Head:Word Suffixes:Interpolation*;
  syntax Shape         = Type:Identifier "(" Args:(Expr; ",")+ ")"
  {
    Args.Expected = SkillType.Float;
    check MT0001 MotionTypes.AllFloat(Args.Select(a => a.Type)) : $"shape '{Type}' takes numbers";
  }
  syntax PartAttribute = Mass / Color / At / Rot;
  syntax Mass          = "mass" "=" Value:Expr { Value.Expected = SkillType.Float; check MT0001 MotionTypes.IsFloat(Value.Type) : MotionTypes.Requires("mass", SkillType.Float, Value.Type); }
  syntax Color         = "color" "=" Value:Tuple;
  syntax At            = "at" "=" Value:Tuple;
  syntax Rot           = "rot" "=" Value:Tuple;
  syntax PartBody      = "{" Items:PartItem* "}";
  syntax PartItem      = Joint / Part / Repeat / For;
  syntax Child         = Part / Repeat / For;
  syntax Repeat        = "repeat" Count:Expr "as" Iterator:Identifier "{" Children:Child* "}"
  {
    Count.Expected = SkillType.Float;
    check MT0001 MotionTypes.IsFloat(Count.Type) : MotionTypes.Requires("a repeat count", SkillType.Float, Count.Type);
  }
  syntax For           = "for" Iterator:Identifier "in" "[" Values:(Identifier; ",")+ "]" "{" Children:Child* "}";

  syntax Joint          = "joint" Type:JointType Attributes:JointAttribute*;
  syntax JointType      = Identifier / "motor";
  syntax JointAttribute = Axis / Range / MotorFlag / SpringFlag / Torque / Force / Speed / Length
                        / Hertz / Damping / Anchor / AnchorSelf / LinearSpeed / AngularAxis
                        / Kp / Kd / MaxSpeed / Pose;
  syntax Axis          = "axis" "=" Value:AxisValue;
  syntax AxisValue     = Identifier / Tuple;
  syntax Range         = "range" "=" "(" Low:Expr ".." High:Expr ")"
  {
    Low.Expected = SkillType.Angle;
    High.Expected = SkillType.Angle;
    check MT0001 MotionTypes.IsFloat(Low.Type) && MotionTypes.IsFloat(High.Type) : $"a joint range takes numbers, got {Low.Type} .. {High.Type}";
    check MT0002 MotionTypes.DimensionFits(Low.Type, SkillType.Angle) && MotionTypes.DimensionFits(High.Type, SkillType.Angle) : $"a joint range takes angles, got {Low.Type} .. {High.Type}";
  }
  syntax MotorFlag     = "motor";
  syntax SpringFlag    = "spring";
  syntax Torque        = "torque" "=" Value:Expr { Value.Expected = SkillType.Float; check MT0001 MotionTypes.IsFloat(Value.Type) : MotionTypes.Requires("torque", SkillType.Float, Value.Type); }
  syntax Force         = "force" "=" Value:Expr { Value.Expected = SkillType.Float; check MT0001 MotionTypes.IsFloat(Value.Type) : MotionTypes.Requires("force", SkillType.Float, Value.Type); }
  syntax Speed         = "speed" "=" Value:Expr { Value.Expected = SkillType.Float; check MT0001 MotionTypes.IsFloat(Value.Type) : MotionTypes.Requires("speed", SkillType.Float, Value.Type); }
  syntax Length        = "length" "=" Value:Expr { Value.Expected = SkillType.Float; check MT0001 MotionTypes.IsFloat(Value.Type) : MotionTypes.Requires("length", SkillType.Float, Value.Type); }
  syntax Hertz         = "hertz" "=" Value:Expr { Value.Expected = SkillType.Float; check MT0001 MotionTypes.IsFloat(Value.Type) : MotionTypes.Requires("hertz", SkillType.Float, Value.Type); }
  syntax Damping       = "damping" "=" Value:Expr { Value.Expected = SkillType.Float; check MT0001 MotionTypes.IsFloat(Value.Type) : MotionTypes.Requires("damping", SkillType.Float, Value.Type); }
  syntax Anchor        = "anchor" "=" Value:Tuple;
  syntax AnchorSelf    = "anchor_self" "=" Value:Tuple;
  syntax LinearSpeed   = "linear_speed" "=" Value:Tuple;
  syntax AngularAxis   = "angular_axis" "=" Value:Tuple;
  syntax Kp            = "kp" "=" Value:Expr { Value.Expected = SkillType.Float; check MT0001 MotionTypes.IsFloat(Value.Type) : MotionTypes.Requires("kp", SkillType.Float, Value.Type); }
  syntax Kd            = "kd" "=" Value:Expr { Value.Expected = SkillType.Float; check MT0001 MotionTypes.IsFloat(Value.Type) : MotionTypes.Requires("kd", SkillType.Float, Value.Type); }
  syntax MaxSpeed      = "max_speed" "=" Value:Expr { Value.Expected = SkillType.Float; check MT0001 MotionTypes.IsFloat(Value.Type) : MotionTypes.Requires("max_speed", SkillType.Float, Value.Type); }
  syntax Pose          = "pose" "=" Value:Expr { Value.Expected = SkillType.Float; check MT0001 MotionTypes.IsFloat(Value.Type) : MotionTypes.Requires("pose", SkillType.Float, Value.Type); }
  syntax Tuple         = "(" Values:(Expr; ",")+ ")"
  {
    Values.Expected = SkillType.Float;
    check MT0001 MotionTypes.AllFloat(Values.Select(v => v.Type)) : "a tuple takes numbers";
  }

  // ---- behavior ----
  syntax Behavior      = "behavior" Name:Identifier "{" Items:BehaviorItem* "}"  declares behavior Name scope;
  syntax BehaviorItem  = Inherit / Model / Reward / Done;
  syntax Inherit       = "inherit" Name:Identifier  references behavior Name;
  syntax Model         = "model" Path:String;
  syntax Reward        = "reward" "{" Value:Expr "}" { Value.Expected = SkillType.Float; check MT0001 MotionTypes.IsFloat(Value.Type) : MotionTypes.Requires("a reward", SkillType.Float, Value.Type); }
  syntax Done          = "done" "when" Condition:Expr { Condition.Expected = SkillType.Bool; check MT0001 MotionTypes.IsBool(Condition.Type) : MotionTypes.Requires("a done condition", SkillType.Bool, Condition.Type); }

  // ---- motion ----
  syntax MotionBlock   = "motion" Name:Identifier "{" Steps:Step* "}";
  syntax Step          = Keyframe / Hold;
  syntax Keyframe      = "at" Time:Expr "pose" "{" Targets:Target* "}"
  {
    Time.Expected = SkillType.Time;
    check MT0001 MotionTypes.IsFloat(Time.Type) : MotionTypes.Requires("a keyframe time", SkillType.Time, Time.Type);
    check MT0002 MotionTypes.DimensionFits(Time.Type, SkillType.Time) : MotionTypes.Requires("a keyframe time", SkillType.Time, Time.Type);
  }
  syntax Target        = Part:Identifier "." Property:Identifier "=" Value:Expr ","?  references part Part
  {
    Value.Expected = SkillType.Float;
    check MT0001 MotionTypes.IsFloat(Value.Type) : MotionTypes.Requires("a pose target", SkillType.Float, Value.Type);
  }
  syntax Hold          = "hold" Duration:Expr
  {
    Duration.Expected = SkillType.Time;
    check MT0001 MotionTypes.IsFloat(Duration.Type) : MotionTypes.Requires("a hold", SkillType.Time, Duration.Type);
    check MT0002 MotionTypes.DimensionFits(Duration.Type, SkillType.Time) : MotionTypes.Requires("a hold", SkillType.Time, Duration.Type);
  }

  // ---- skills (Plan 6); semantic rules live in MotionAstMapper ----
  syntax Skill          = "skill" Name:Identifier "{" Lifecycle:Lifecycle Length:SkillLength? Items:SkillItem* "}"  declares skill Name scope;
  syntax Lifecycle      = "lifecycle" Mode:LifecycleMode Fields:LifecycleField*
  {
    check MV0005 MotionValues.UnstatedLengthProblem(Semantics, Node) is null : MotionValues.UnstatedLengthProblem(Semantics, Node)!;
  }
  syntax LifecycleMode  = "finite" / "looping" / "continuous";
  syntax LifecycleField = Field:("duration" / "period" / "fade_in" / "fade_out") Value:Expr
  {
    Value.Expected = SkillType.Time;
    check MT0001 MotionTypes.IsFloat(Value.Type) : MotionTypes.Requires($"'{Field}'", SkillType.Time, Value.Type);
    check MT0002 MotionTypes.DimensionFits(Value.Type, SkillType.Time) : MotionTypes.Requires($"'{Field}'", SkillType.Time, Value.Type);
    check MV0001 !MotionValues.Checkable(Value.Type) || MotionValues.Finite(Value.Constant) : $"Lifecycle {Field} must be a finite constant float.";
    check MV0002 MotionValues.NonNegative(Value.Constant) : $"Lifecycle {Field} cannot be negative.";
  }
  syntax SkillLength    = "length" Value:Expr
  {
    Value.Expected = SkillType.Time;
    check MT0001 MotionTypes.IsFloat(Value.Type) : MotionTypes.Requires("a skill length", SkillType.Time, Value.Type);
    check MT0002 MotionTypes.DimensionFits(Value.Type, SkillType.Time) : MotionTypes.Requires("a skill length", SkillType.Time, Value.Type);
    check MV0001 !MotionValues.Checkable(Value.Type) || MotionValues.Finite(Value.Constant) : "Skill length must be a finite constant float.";
    check MV0002 MotionValues.NonNegative(Value.Constant) : "Skill length cannot be negative.";
    check MV0005 MotionValues.StatedLengthProblem(Semantics, Node) is null : MotionValues.StatedLengthProblem(Semantics, Node)!;
  }
  syntax SkillItem      = Declarations / Requires / Source / Output / Completion / Timeout;

  syntax Declarations     = Section:("arguments" / "inputs") "{" Values:ValueDeclaration* "}" { Values.Section = Section.Text; }
  syntax ValueDeclaration = Name:Identifier ":" Type:ValueType Default:("=" Expr)? Limits:("range" Bounds)?  declares value Name
  {
    in Section : string? = null;
    symbol.Type = Type.Value;
    symbol.Section = Section;
    Default.Expected = Type.Value;
    check MT0001 Default is null || MotionTypes.KindFits(Default.Value.Type, Type.Value) : MotionTypes.Requires($"the default of '{Name}'", Type.Value, Default?.Type ?? SkillType.Error);
    check MT0004 Default is null || MotionTypes.SameEnum(Default.Value.Type, Type.Value) : $"the default of '{Name}' is a value of another enum";
    check MT0001 Limits is null || Type.Value.Kind == SkillTypeKind.Float : $"a range on '{Name}' requires float, not {Type.Value}";
    check MV0004 !(Limits is { } range && range.Low.Constant is float low && range.High.Constant is float high && low > high) : $"Range for '{Name}' is inverted.";
    check MV0004 !(Limits is { } bounds && bounds.Low.Constant is float min && bounds.High.Constant is float max && min <= max && Default?.Constant is float value && (value < min || value > max)) : $"Default for '{Name}' is outside its range.";
  }
  syntax ValueType        = "float" / "bool" / EnumType
  {
    out Value : SkillType = SkillType.Error;
    Value = Text == "float" ? SkillType.Float : Text == "bool" ? SkillType.Bool : new EnumTypeNodeSemantics(Semantics, Semantics.Tree.Child(Node, 0)).Enum;
  }
  syntax EnumType         = "enum" "(" Values:(EnumValue; ",")+ ")"
  {
    out Enum : SkillType = SkillType.Error;
    Enum = SkillType.EnumOf(Semantics.Path + "#" + Node, Text);
    Values.Owner = Enum;
  }
  syntax EnumValue        = Name:Identifier  declares value Name { in Owner : SkillType = SkillType.Error; symbol.Type = Owner; }
  syntax Bounds           = "(" Low:Expr ".." High:Expr ")"
  {
    Low.Expected = SkillType.Float;
    High.Expected = SkillType.Float;
    check MT0001 MotionTypes.IsFloat(Low.Type) && MotionTypes.IsFloat(High.Type) : $"a range takes numbers, got {Low.Type} .. {High.Type}";
    check MV0001 !MotionValues.Checkable(Low.Type) || MotionValues.Finite(Low.Constant) : "Range minimum must be a finite constant float.";
    check MV0001 !MotionValues.Checkable(High.Type) || MotionValues.Finite(High.Constant) : "Range maximum must be a finite constant float.";
  }
  syntax Requires         = "requires" "motors" "{" Motors:MotorDecl* "}";
  syntax MotorDecl        = Path:SemanticPath  declares motor Path;
  syntax SemanticPath     = Segments:(Identifier; ".")+;

  syntax Source         = "source" Name:Identifier ":" Body:SourceBody  declares source Name;
  syntax SourceBody     = Tracks / Phases / Mpc / Nested / BlendSource;
  syntax Modifiers      = "persistent" Paused:"paused"?;

  syntax Tracks         = "tracks" "{" Modifiers:Modifiers? Items:Track* "}";
  syntax Track          = "track" Target:TrackTarget "{" "from" From:TrackValue "to" To:Expr
                          "during" Start:Expr ".." End:Expr "easing" Easing:Identifier Release:"release"? "}"  references easing Easing
  {
    To.Expected = Target.ChannelType;
    Start.Expected = SkillType.Time;
    End.Expected = SkillType.Time;
    check MT0001 MotionTypes.IsFloat(From.Get(MotionModule.P_Expr_Type)) && MotionTypes.IsFloat(To.Type) : $"a track's values are numbers, got {From.Get(MotionModule.P_Expr_Type)} to {To.Type}";
    check MT0002 MotionTypes.DimensionFits(From.Get(MotionModule.P_Expr_Type), Target.ChannelType) && MotionTypes.DimensionFits(To.Type, Target.ChannelType) : $"'{Target}' takes {Target.ChannelType}, got {From.Get(MotionModule.P_Expr_Type)} to {To.Type}";
    check MT0001 MotionTypes.IsFloat(Start.Type) && MotionTypes.IsFloat(End.Type) : $"a track's time range is numbers, got {Start.Type} .. {End.Type}";
    check MT0002 MotionTypes.DimensionFits(Start.Type, SkillType.Time) && MotionTypes.DimensionFits(End.Type, SkillType.Time) : $"a track's time range is in seconds, got {Start.Type} .. {End.Type}";
    check MV0001 !MotionValues.Checkable(Start.Type) || MotionValues.Finite(Start.Constant) : "Track start must be a finite constant float.";
    check MV0001 !MotionValues.Checkable(End.Type) || MotionValues.Finite(End.Constant) : "Track end must be a finite constant float.";
    check MV0003 MotionValues.NonNegative(Start.Constant) && MotionValues.NonNegative(End.Constant) : "Track time range cannot be negative.";
    check MV0003 !(Start.Constant is float first && End.Constant is float last && last < first) : "Track time range has end before start.";
  }
  syntax TrackValue     = RestValue / Expr;
  syntax RestValue      = "rest";
  syntax TrackTarget    = Motor:TrackMotor "." Channel:Channel  references motor Motor
  {
    out ChannelType : SkillType = SkillType.Float;
    ChannelType = MotionTypes.Channel(Channel.Text);
  }
  syntax TrackMotor     = Head:Identifier Parts:TargetPart*;
  syntax TargetPart     = PathIndex / PathMember;
  syntax PathIndex      = "[" Name:Identifier "]";
  syntax PathMember     = "." Name:Identifier;
  syntax Channel        = "target_angle" / "angle_offset" / "kp" / "kd" / "max_speed" / "feedforward_torque" / "max_torque";

  syntax Phases             = "phases" "{" Modifiers:Modifiers? Items:Phase* "}"  scope
  {
    check MV0006 Items.Count > 0 : "A phase source must contain at least one phase.";
  }
  syntax Phase              = "phase" Name:Identifier "{" Items:PhaseItem* "}"  declares phase Name
  {
    check MV0006 MotionValues.PhaseProblem(Semantics, Node) is null : MotionValues.PhaseProblem(Semantics, Node)!;
    check MV0007 MotionValues.PoseProblem(Semantics, Node) is null : MotionValues.PoseProblem(Semantics, Node)!;
  }
  syntax PhaseItem          = Transition / PhasePose / Override / PhaseHold / RootPosition / RootRotation;
  syntax Transition         = "transition" Duration:Expr "easing" Easing:Identifier  references easing Easing
  {
    Duration.Expected = SkillType.Time;
    check MT0001 MotionTypes.IsFloat(Duration.Type) : MotionTypes.Requires("a transition", SkillType.Time, Duration.Type);
    check MT0002 MotionTypes.DimensionFits(Duration.Type, SkillType.Time) : MotionTypes.Requires("a transition", SkillType.Time, Duration.Type);
    check MV0001 !MotionValues.Checkable(Duration.Type) || MotionValues.Finite(Duration.Constant) : "Phase transition must be a non-negative finite constant.";
    check MV0002 MotionValues.NonNegative(Duration.Constant) : "Phase transition must be a non-negative finite constant.";
  }
  syntax PhasePose          = "pose" "{" Targets:PoseTarget* "}";
  syntax PoseTarget         = Slot:SemanticPath "=" Value:TrackValue  references motor Slot
  {
    check MT0001 MotionTypes.IsFloat(Value.Get(MotionModule.P_Expr_Type)) : MotionTypes.Requires("a phase target", SkillType.Angle, Value.Get(MotionModule.P_Expr_Type));
    check MT0002 MotionTypes.DimensionFits(Value.Get(MotionModule.P_Expr_Type), SkillType.Angle) : MotionTypes.Requires("a phase target", SkillType.Angle, Value.Get(MotionModule.P_Expr_Type));
    check MV0007 MotionValues.DuplicateMotor(Semantics, Node) is null : MotionValues.DuplicateMotor(Semantics, Node)!;
    check MV0008 MotionValues.TargetProblem(Semantics, Node) is null : MotionValues.TargetProblem(Semantics, Node)!;
  }
  syntax Override           = "override" Slot:SemanticPath "{" Items:OverrideItem* "}"  references motor Slot
  {
    check MV0009 MotionValues.OverrideProblem(Semantics, Node) is null : MotionValues.OverrideProblem(Semantics, Node)!;
  }
  syntax OverrideItem       = OverrideDelay / OverrideTransition / OverrideEasing;
  syntax OverrideDelay      = "delay" Value:Expr
  {
    Value.Expected = SkillType.Time;
    check MT0001 MotionTypes.IsFloat(Value.Type) : MotionTypes.Requires("an override delay", SkillType.Time, Value.Type);
    check MT0002 MotionTypes.DimensionFits(Value.Type, SkillType.Time) : MotionTypes.Requires("an override delay", SkillType.Time, Value.Type);
    check MV0001 !MotionValues.Checkable(Value.Type) || MotionValues.Finite(Value.Constant) : "Motor window delay must be a non-negative finite constant.";
    check MV0002 MotionValues.NonNegative(Value.Constant) : "Motor window delay must be a non-negative finite constant.";
  }
  syntax OverrideTransition = "transition" Value:Expr
  {
    Value.Expected = SkillType.Time;
    check MT0001 MotionTypes.IsFloat(Value.Type) : MotionTypes.Requires("an override transition", SkillType.Time, Value.Type);
    check MT0002 MotionTypes.DimensionFits(Value.Type, SkillType.Time) : MotionTypes.Requires("an override transition", SkillType.Time, Value.Type);
    check MV0001 !MotionValues.Checkable(Value.Type) || MotionValues.Finite(Value.Constant) : "Motor transition override must be a non-negative finite constant.";
    check MV0002 MotionValues.NonNegative(Value.Constant) : "Motor transition override must be a non-negative finite constant.";
  }
  syntax OverrideEasing     = "easing" Name:Identifier  references easing Name;
  syntax PhaseHold          = "hold" Value:Expr
  {
    Value.Expected = SkillType.Time;
    check MT0001 MotionTypes.IsFloat(Value.Type) : MotionTypes.Requires("a phase hold", SkillType.Time, Value.Type);
    check MT0002 MotionTypes.DimensionFits(Value.Type, SkillType.Time) : MotionTypes.Requires("a phase hold", SkillType.Time, Value.Type);
    check MV0001 !MotionValues.Checkable(Value.Type) || MotionValues.Finite(Value.Constant) : "Phase hold must be a non-negative finite constant.";
    check MV0002 MotionValues.NonNegative(Value.Constant) : "Phase hold must be a non-negative finite constant.";
  }
  syntax RootPosition       = "root_position_offset" "(" Values:(RootLiteral; ",")+ ")";
  syntax RootRotation       = "root_rotation_offset" "(" Values:(RootLiteral; ",")+ ")";
  syntax RootLiteral        = Negative:"-"? Value:Number;

  syntax Mpc              = "mpc" Controller:String "{" Modifiers:Modifiers? Inputs:InputMapping* "}";
  syntax Nested           = "nested" SkillName:Identifier "{" Modifiers:Modifiers? Items:NestedItem* "}"  references skill SkillName
  {
    check MV0010 MotionValues.NestedCycle(Semantics, Node) is null : MotionValues.NestedCycle(Semantics, Node)!;
  }
  syntax NestedItem       = ArgumentMapping / InputMapping;
  syntax ArgumentMapping  = "argument" Name:Identifier "=" Value:Expr  references value Name in skill
  {
    Value.Expected = Symbol?.Type;
    check MT0001 MotionTypes.KindFits(Value.Type, Symbol?.Type) : MotionTypes.Requires($"argument '{Name}'", Symbol?.Type, Value.Type);
    check MT0004 MotionTypes.SameEnum(Value.Type, Symbol?.Type) : $"argument '{Name}' takes a value of its own enum";
    check MT0005 Symbol is null || Symbol.Value.Section != "inputs" : $"'{Name}' is an input of the nested skill: map it with 'input'";
  }
  syntax InputMapping     = "input" Name:Identifier "=" Value:Expr  references value Name in skill
  {
    Value.Expected = Symbol?.Type;
    check MT0001 MotionTypes.KindFits(Value.Type, Symbol?.Type) : MotionTypes.Requires($"input '{Name}'", Symbol?.Type, Value.Type);
    check MT0004 MotionTypes.SameEnum(Value.Type, Symbol?.Type) : $"input '{Name}' takes a value of its own enum";
    check MT0005 Symbol is null || Symbol.Value.Section != "arguments" : $"'{Name}' is an argument of the nested skill: map it with 'argument'";
  }

  syntax BlendSource           = "blend" "{" Children:BlendChild* "}";
  syntax Output                = "output" "blend" "{" Children:BlendChild* "}";
  syntax BlendChild            = Source:Identifier Mode:BlendMode  references source Source
  {
    check MV0010 MotionValues.AdditiveProblem(Semantics, Node) is null : MotionValues.AdditiveProblem(Semantics, Node)!;
    check MV0010 MotionValues.SourceCycle(Semantics, Node) is null : MotionValues.SourceCycle(Semantics, Node)!;
  }
  syntax BlendMode             = PriorityMode / WeightedMode / AdditiveMode / ParameterWeightedMode;
  syntax PriorityMode          = "priority" Value:Expr { Value.Expected = SkillType.Float; check MT0001 MotionTypes.IsFloat(Value.Type) : MotionTypes.Requires("a priority", SkillType.Float, Value.Type); check MV0010 !MotionValues.Checkable(Value.Type) || MotionValues.Integer(Value.Constant) : "Priority must be a constant integer."; }
  syntax WeightedMode          = "weighted" "weight" Value:Expr { Value.Expected = SkillType.Float; check MT0001 MotionTypes.IsFloat(Value.Type) : MotionTypes.Requires("a weight", SkillType.Float, Value.Type); check MV0010 !MotionValues.Checkable(Value.Type) || Value.Constant is not null : "Dynamic weights require parameter_weighted mode."; }
  syntax AdditiveMode          = "additive" "weight" Value:Expr { Value.Expected = SkillType.Float; check MT0001 MotionTypes.IsFloat(Value.Type) : MotionTypes.Requires("a weight", SkillType.Float, Value.Type); check MV0010 !MotionValues.Checkable(Value.Type) || Value.Constant is not null : "Dynamic weights require parameter_weighted mode."; }
  syntax ParameterWeightedMode = "parameter_weighted" "weight" Value:Expr { Value.Expected = SkillType.Float; check MT0001 MotionTypes.IsFloat(Value.Type) : MotionTypes.Requires("a weight", SkillType.Float, Value.Type); }

  syntax Completion     = "complete" "when" Condition:Expr Dwell:("for" Expr)?
  {
    Condition.Expected = SkillType.Bool;
    Dwell.Expected = SkillType.Time;
    check MT0001 MotionTypes.IsBool(Condition.Type) : MotionTypes.Requires("a completion condition", SkillType.Bool, Condition.Type);
    check MT0001 Dwell is null || MotionTypes.IsFloat(Dwell.Value.Type) : MotionTypes.Requires("a completion dwell", SkillType.Time, Dwell?.Type ?? SkillType.Error);
    check MT0002 Dwell is null || MotionTypes.DimensionFits(Dwell.Value.Type, SkillType.Time) : MotionTypes.Requires("a completion dwell", SkillType.Time, Dwell?.Type ?? SkillType.Error);
    check MV0001 Dwell is null || !MotionValues.Checkable(Dwell.Value.Type) || MotionValues.Finite(Dwell.Value.Constant) : "Completion dwell must be a finite constant float.";
    check MV0002 Dwell is null || MotionValues.NonNegative(Dwell.Value.Constant) : "Completion dwell cannot be negative.";
  }
  syntax Timeout        = "timeout" Duration:Expr "then" Result:("complete" / "fail")
  {
    Duration.Expected = SkillType.Time;
    check MT0001 MotionTypes.IsFloat(Duration.Type) : MotionTypes.Requires("a timeout", SkillType.Time, Duration.Type);
    check MT0002 MotionTypes.DimensionFits(Duration.Type, SkillType.Time) : MotionTypes.Requires("a timeout", SkillType.Time, Duration.Type);
    check MV0001 !MotionValues.Checkable(Duration.Type) || MotionValues.Finite(Duration.Constant) : "Timeout must be a finite constant float.";
    check MV0002 MotionValues.NonNegative(Duration.Constant) : "Timeout cannot be negative.";
  }


  // ---- expressions: MotionParser precedences shifted up by one (see the plan) ----
  syntax Unit          = "deg" / "s";

  extensible syntax Expr
  {
    out hover Type : SkillType = SkillType.Error;
    in expected Expected : SkillType? = null;
    out Constant : float? = null;

    | Num          = Value:Number Unit:Unit?  { Type = MotionTypes.Number(Unit?.Text); Constant = MotionValues.Number(Value.Text, Unit?.Text); }
    | True         = "true"  { Type = SkillType.Bool; Constant = 1f; }
    | False        = "false" { Type = SkillType.Bool; Constant = 0f; }
    | Call         = Callee:Identifier "(" Args:(Expr; ",")* ")"   references (function | reward) Callee
      {
        Type = MotionTypes.Call(Symbol?.Kind, Callee.Text, Args.Select(a => a.Type).ToList());
        check MT0003 MotionTypes.ArityFits(Symbol?.Kind, Callee.Text, Args.Count) : $"'{Callee}' takes {MotionTypes.Arity(Symbol?.Kind, Callee.Text)} argument(s), got {Args.Count}";
        check MT0001 MotionTypes.ArgumentsFit(Symbol?.Kind, Args.Select(a => a.Type).ToList()) : $"'{Callee}' takes numbers";
        check MT0002 MotionTypes.ArgumentDimensionsFit(Symbol?.Kind, Callee.Text, Args.Select(a => a.Type).ToList()) : $"the arguments of '{Callee}' have clashing units";
        Constant = Type.IsError ? null : MotionValues.Call(Symbol?.Kind, Callee.Text, Args.Select(a => a.Constant).ToList());
      }
    | Ref          = Identifier                                     references (value | part | reward | axis | subject) this
      { Type = Symbol?.Type ?? SkillType.Error; Constant = null; }
    | Paren        = "(" Expr ")"  { Type = Expr.Type; Expr.Expected = Expected; Constant = Expr.Constant; }
    | Negate       = "-" Expr                         precedence 8
      { Type = MotionTypes.Negate(Expr.Type); check MT0001 MotionTypes.IsFloat(Expr.Type) : $"unary '-' requires float, got {Expr.Type}"; Constant = Type.IsError ? null : MotionValues.Negate(Expr.Constant); }
    | Not          = "not" Expr                       precedence 8
      { Type = MotionTypes.Not(Expr.Type); check MT0001 MotionTypes.IsBool(Expr.Type) : $"'not' requires bool, got {Expr.Type}"; Constant = Type.IsError ? null : MotionValues.Not(Expr.Constant); }
    | Member       = Expr "." Property:Identifier     precedence 9 left   references? value this
      { Type = Symbol?.Type ?? MotionTypes.Member(Expr.Type); Constant = null; }
    | Ternary      = Expr "?" Then:Expr ":" Else:Expr precedence 1 right
      {
        Type = MotionTypes.Ternary(Expr.Type, Then.Type, Else.Type);
        Then.Expected = Expected;
        Else.Expected = Expected;
        check MT0001 MotionTypes.IsBool(Expr.Type) : $"a ternary condition requires bool, got {Expr.Type}";
        check MT0001 MotionTypes.KindFits(Then.Type, Else.Type) : $"a ternary's branches differ: {Then.Type} and {Else.Type}";
        check MT0002 MotionTypes.DimensionFits(Then.Type, Else.Type) : $"a ternary's branches have clashing units: {Then.Type} and {Else.Type}";
        Constant = Type.IsError ? null : MotionValues.Ternary(Expr.Constant, Then.Constant, Else.Constant);
      }
    | Or           = Expr "or" Expr                   precedence 2 left
      { Type = MotionTypes.Logic(Expr1.Type, Expr2.Type); check MT0001 MotionTypes.IsBool(Expr1.Type) && MotionTypes.IsBool(Expr2.Type) : $"'or' requires bools, got {Expr1.Type} and {Expr2.Type}"; Constant = Type.IsError ? null : MotionValues.Logic(false, Expr1.Constant, Expr2.Constant); }
    | And          = Expr "and" Expr                  precedence 3 left
      { Type = MotionTypes.Logic(Expr1.Type, Expr2.Type); check MT0001 MotionTypes.IsBool(Expr1.Type) && MotionTypes.IsBool(Expr2.Type) : $"'and' requires bools, got {Expr1.Type} and {Expr2.Type}"; Constant = Type.IsError ? null : MotionValues.Logic(true, Expr1.Constant, Expr2.Constant); }
    | Equal        = Expr "==" Expr                   precedence 4 left
      {
        Type = MotionTypes.Equality(Expr1.Type, Expr2.Type);
        Expr2.Expected = Expr1.Type;
        check MT0001 MotionTypes.KindFits(Expr1.Type, Expr2.Type) : $"'==' compares {Expr1.Type} with {Expr2.Type}";
        check MT0004 MotionTypes.SameEnum(Expr1.Type, Expr2.Type) : $"'==' compares values of different enums: {Expr1.Type} and {Expr2.Type}";
        check MT0002 MotionTypes.DimensionFits(Expr1.Type, Expr2.Type) : $"'==' compares {Expr1.Type} with {Expr2.Type}";
        Constant = Type.IsError ? null : MotionValues.Compare("==", Expr1.Constant, Expr2.Constant);
      }
    | NotEqual     = Expr "!=" Expr                   precedence 4 left
      {
        Type = MotionTypes.Equality(Expr1.Type, Expr2.Type);
        Expr2.Expected = Expr1.Type;
        check MT0001 MotionTypes.KindFits(Expr1.Type, Expr2.Type) : $"'!=' compares {Expr1.Type} with {Expr2.Type}";
        check MT0004 MotionTypes.SameEnum(Expr1.Type, Expr2.Type) : $"'!=' compares values of different enums: {Expr1.Type} and {Expr2.Type}";
        check MT0002 MotionTypes.DimensionFits(Expr1.Type, Expr2.Type) : $"'!=' compares {Expr1.Type} with {Expr2.Type}";
        Constant = Type.IsError ? null : MotionValues.Compare("!=", Expr1.Constant, Expr2.Constant);
      }
    | Less         = Expr "<" Expr                    precedence 5 left
      { Type = MotionTypes.Compare(Expr1.Type, Expr2.Type); check MT0001 MotionTypes.IsFloat(Expr1.Type) && MotionTypes.IsFloat(Expr2.Type) : $"'<' compares numbers, got {Expr1.Type} and {Expr2.Type}"; check MT0002 MotionTypes.DimensionFits(Expr1.Type, Expr2.Type) : $"'<' compares {Expr1.Type} with {Expr2.Type}"; Constant = Type.IsError ? null : MotionValues.Compare("<", Expr1.Constant, Expr2.Constant); }
    | Greater      = Expr ">" Expr                    precedence 5 left
      { Type = MotionTypes.Compare(Expr1.Type, Expr2.Type); check MT0001 MotionTypes.IsFloat(Expr1.Type) && MotionTypes.IsFloat(Expr2.Type) : $"'>' compares numbers, got {Expr1.Type} and {Expr2.Type}"; check MT0002 MotionTypes.DimensionFits(Expr1.Type, Expr2.Type) : $"'>' compares {Expr1.Type} with {Expr2.Type}"; Constant = Type.IsError ? null : MotionValues.Compare(">", Expr1.Constant, Expr2.Constant); }
    | LessEqual    = Expr "<=" Expr                   precedence 5 left
      { Type = MotionTypes.Compare(Expr1.Type, Expr2.Type); check MT0001 MotionTypes.IsFloat(Expr1.Type) && MotionTypes.IsFloat(Expr2.Type) : $"'<=' compares numbers, got {Expr1.Type} and {Expr2.Type}"; check MT0002 MotionTypes.DimensionFits(Expr1.Type, Expr2.Type) : $"'<=' compares {Expr1.Type} with {Expr2.Type}"; Constant = Type.IsError ? null : MotionValues.Compare("<=", Expr1.Constant, Expr2.Constant); }
    | GreaterEqual = Expr ">=" Expr                   precedence 5 left
      { Type = MotionTypes.Compare(Expr1.Type, Expr2.Type); check MT0001 MotionTypes.IsFloat(Expr1.Type) && MotionTypes.IsFloat(Expr2.Type) : $"'>=' compares numbers, got {Expr1.Type} and {Expr2.Type}"; check MT0002 MotionTypes.DimensionFits(Expr1.Type, Expr2.Type) : $"'>=' compares {Expr1.Type} with {Expr2.Type}"; Constant = Type.IsError ? null : MotionValues.Compare(">=", Expr1.Constant, Expr2.Constant); }
    | Add          = Expr "+" Expr                    precedence 6 left
      { Type = MotionTypes.Sum(Expr1.Type, Expr2.Type); check MT0001 MotionTypes.IsFloat(Expr1.Type) && MotionTypes.IsFloat(Expr2.Type) : $"'+' adds numbers, got {Expr1.Type} and {Expr2.Type}"; check MT0002 MotionTypes.DimensionFits(Expr1.Type, Expr2.Type) : $"'+' adds {Expr1.Type} to {Expr2.Type}"; Constant = Type.IsError ? null : MotionValues.Arithmetic('+', Expr1.Constant, Expr2.Constant); }
    | Sub          = Expr "-" Expr                    precedence 6 left
      { Type = MotionTypes.Sum(Expr1.Type, Expr2.Type); check MT0001 MotionTypes.IsFloat(Expr1.Type) && MotionTypes.IsFloat(Expr2.Type) : $"'-' subtracts numbers, got {Expr1.Type} and {Expr2.Type}"; check MT0002 MotionTypes.DimensionFits(Expr1.Type, Expr2.Type) : $"'-' subtracts {Expr2.Type} from {Expr1.Type}"; Constant = Type.IsError ? null : MotionValues.Arithmetic('-', Expr1.Constant, Expr2.Constant); }
    | Mul          = Expr "*" Expr                    precedence 7 left
      { Type = MotionTypes.Product(Expr1.Type, Expr2.Type); check MT0001 MotionTypes.IsFloat(Expr1.Type) && MotionTypes.IsFloat(Expr2.Type) : $"'*' multiplies numbers, got {Expr1.Type} and {Expr2.Type}"; Constant = Type.IsError ? null : MotionValues.Arithmetic('*', Expr1.Constant, Expr2.Constant); }
    | Div          = Expr "/" Expr                    precedence 7 left
      { Type = MotionTypes.Product(Expr1.Type, Expr2.Type); check MT0001 MotionTypes.IsFloat(Expr1.Type) && MotionTypes.IsFloat(Expr2.Type) : $"'/' divides numbers, got {Expr1.Type} and {Expr2.Type}"; Constant = Type.IsError ? null : MotionValues.Arithmetic('/', Expr1.Constant, Expr2.Constant); check MV0001 !(Expr2.Constant is 0f && MotionValues.Inside(Semantics, Node, MotionKinds.Skill)) : "Constant division by zero is not allowed."; }
  }
}
