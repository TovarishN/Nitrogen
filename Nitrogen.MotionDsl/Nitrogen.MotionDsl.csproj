<Project Sdk="Microsoft.NET.Sdk">

  <!-- MotionDSL on Nitrogen: Motion.ngr and Policy.ngr, generated at build time, mapped to Gravity.MotionDSL.Ast. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <RootNamespace>Nitrogen.MotionDsl</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nitrogen.Runtime\Nitrogen.Runtime.csproj" />
    <ProjectReference Include="..\..\MotionDSL\MotionDSL.csproj" />
    <ProjectReference Include="..\Nitrogen.Generator\Nitrogen.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Motion.ngr" Namespace="Nitrogen.MotionDsl.Syntax" />
    <AdditionalFiles Include="Policy.ngr" Namespace="Nitrogen.MotionDsl.PolicySyntax" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="Namespace" />
    <CompilerVisibleProperty Include="RootNamespace" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Nitrogen.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
