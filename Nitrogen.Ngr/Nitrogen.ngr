// The grammar language, described in itself. Nitrogen.Ngr generates its parser from this file;
// SelfHostingTests require it to map every .ngr file to the bootstrap parser's GrammarModel.
syntax module Nitrogen
{
  token IdStart    = ['a'..'z' 'A'..'Z' '_'];
  token IdPart     = ['a'..'z' 'A'..'Z' '0'..'9' '_'];
  token Identifier = IdStart IdPart*;
  token DottedName = Identifier ("." Identifier)+;
  token Integer    = ['0'..'9']+;
  token Hex        = ['0'..'9' 'a'..'f' 'A'..'F'];
  token Escape     = "\\" (['n' 'r' 't' '0' '\\' '"' '\''] / "u" Hex Hex Hex Hex);
  token String     = "\"" (Escape / [^ '"' '\\' '\n'])* "\"";
  token Char       = "'" (Escape / [^ '\'' '\\' '\n']) "'";
  // A grammar function call (spec: grammar functions): the name touches its '(' so `Name (X)` stays a reference and a group.
  token CallHead   = (DottedName / Identifier) "(";

  // Semantics (issue 239): C# is text up to a top-level stop character, as CSharpCapture scans it:
  // brackets nest and must match; strings, chars and comments are skipped.
  token CsEsc     = "\\" .;
  token CsString  = ("$@" / "@$" / "@") "\"" ("\"\"" / [^ '"'])* "\"" / "$"? "\"" (CsEsc / [^ '"' '\\' '\n'])* "\"";
  token CsChar    = "'" (CsEsc / [^ '\'' '\\' '\n'])+ "'";
  token CsComment = "//" [^ '\n']* / "/*" (!"*/" .)* "*/";
  token CsNested  = "(" CsInner ")" / "[" CsInner "]" / "{" CsInner "}";
  token CsInner   = (CsString / CsChar / CsComment / CsNested / [^ '(' ')' '[' ']' '{' '}' '"' '\''])*;
  token CsCode    = (CsString / CsChar / CsComment / CsNested / [^ '(' ')' '[' ']' '{' '}' '"' '\'' ';'])+;
  // A rewrite template; the name colours it as a string in the editor.
  token TemplateString = "<[" (!"]>" .)* "]>";
  token CsCond    = (CsString / CsChar / CsComment / CsNested / [^ '(' ')' '[' ']' '{' '}' '"' '\'' ';' ':'])+;
  token CsType    = (CsString / CsChar / CsComment / CsNested / [^ '(' ')' '[' ']' '{' '}' '"' '\'' ';' '='])+;
  token CheckCode = ['A'..'Z'] ['A'..'Z']+ ['0'..'9'] ['0'..'9'] ['0'..'9'] ['0'..'9'] !IdPart;
  // `check … : message at Child;` (issue 241): the message stops before a trailing `at Name ;`.
  token CsAtTail  = [' ' '\t' '\r' '\n']+ "at" [' ' '\t' '\r' '\n']+ IdStart IdPart* [' ' '\t' '\r' '\n']* ";";
  token CsMessage = (!CsAtTail (CsString / CsChar / CsComment / CsNested / [^ '(' ')' '[' ']' '{' '}' '"' '\'' ';']))+;

  // Binding (issue 238): modules and rules, for outlines and colour. References are optional: a
  // qualified or used name from another module simply stays unresolved and unreported.
  symbols { module rule property }

  syntax File           = Languages:LanguageDeclaration? Modules:Module*  lowers Grammar.File(sequence Grammar.Module Modules, optional Grammar.LanguageDeclaration Languages);
  syntax LanguageDeclaration = "language" Name:Identifier "{" Settings:LanguageSetting* "}"
                          lowers Grammar.LanguageDeclaration(text Name, sequence Grammar.LanguageSetting Settings);
  syntax LanguageSetting = LanguageNameSetting / LanguageStringSetting / LanguageUsingSetting / LanguagePresentationSetting;
  syntax LanguageNameSetting = Kind:("start" / "namespace") Name:LanguageQualifiedName ";"
                          lowers Grammar.LanguageNameSetting(text Kind, text Name);
  syntax LanguageQualifiedName = Name:QualifiedName references? (module | rule) Name lowers text Core.Text Name;
  syntax LanguageStringSetting = Kind:("grammars" / "sources" / "extensions") Values:(LanguageString; ",")+ ";"
                          lowers Grammar.LanguageListSetting(text Kind, sequence Core.Text Values);
  syntax LanguageString = Value:String lowers text Core.Text Value;
  syntax LanguageUsingSetting = Kind:"usings" Values:(LanguageName; ",")+ ";"
                          lowers Grammar.LanguageUsingSetting(text Kind, sequence Core.Text Values);
  syntax LanguageName = Value:QualifiedName lowers text Core.Text Value;
  syntax LanguagePresentationSetting = Kind:("tokens" / "types") Name:QualifiedName Value:String ";"
                          lowers Grammar.LanguagePresentationSetting(text Kind, text Name, text Value);
  syntax Module         = "syntax" "module" Name:QualifiedName "{" Members:Member* "}"  declares module Name scope
                          lowers Grammar.Module(text Name, sequence Grammar.Member Members);
  syntax Member         = NamedPattern / QuoteMatchHelper / QuoteHelper / GrammarFunction / Using / Symbols / SymbolProperty / Builtin / TokenRule / SyntaxRule / ExtensibleRule / Extend;
  syntax QuoteHelper = "syntax"? "function" Name:Identifier "(" Parameters:(QuoteParameter; ",")* ")" ":" Category:QualifiedName "=" Body:TemplateString ";"
                       lowers Grammar.QuoteHelper(text Name, sequence Grammar.QuoteParameter Parameters, text Category, text Body);
  syntax QuoteMatchHelper = "syntax"? "function" Name:Identifier "(" Parameters:(QuoteParameter; ",")* ")" ":" Category:QualifiedName "=" Body:QuoteMatchBody ";"
                       lowers Grammar.QuoteMatchHelper(text Name, sequence Grammar.QuoteParameter Parameters, text Category, Body);
  syntax QuoteMatchBody = "match" Selector:Identifier "{" Arms:QuoteMatchArm* "|" "_" "=>" Fallback:TemplateString ";" "}"
                       lowers Grammar.QuoteMatchBody(text Selector, sequence Grammar.QuoteMatchArm Arms, text Fallback);
  syntax QuoteMatchArm = "|" Captures:QuoteCaptures? Pattern:TemplateString "=>" Result:TemplateString ";"
                       lowers Grammar.QuoteMatchArm(optional Grammar.QuoteCaptures Captures, text Pattern, text Result);
  syntax QuoteCaptures = "(" Parameters:(QuoteParameter; ",")* ")"
                       lowers Grammar.QuoteCaptures(sequence Grammar.QuoteParameter Parameters);
  syntax QuoteParameter = Name:Identifier ":" Descendant:DescendantMarker? Category:QualifiedName List:ListMarker?
                       lowers Grammar.QuoteParameter(text Name, text Category, optional Core.Text List, optional Core.Text Descendant);
  syntax ListMarker = Value:"*" lowers text Core.Text Value;
  syntax DescendantMarker = Value:".." lowers text Core.Text Value;
  syntax NamedPattern = "pattern" Name:Identifier ":" Category:QualifiedName "=" "|"? Alternatives:(NamedPatternAlternative; "|")+ ";"
                       lowers Grammar.NamedPattern(text Name, text Category, sequence Grammar.NamedPatternAlternative Alternatives);
  syntax NamedPatternAlternative = Captures:QuoteCaptures? Pattern:TemplateString
                       lowers Grammar.NamedPatternAlternative(optional Grammar.QuoteCaptures Captures, text Pattern);
  syntax HelperArgument = Name:Identifier lowers text Core.Text Name;
  // Grammar functions (spec: grammar functions): evaluated when the grammar is compiled.
  syntax GrammarFunction = "syntax"? "function" Name:Identifier "(" Parameters:(QuoteParameter; ",")* ")" ":" ReturnType:QualifiedName "="
                         Lets:LetBinding* Body:Expression ";"
                       lowers Grammar.GrammarFunction(text Name, sequence Grammar.QuoteParameter Parameters, text ReturnType, sequence Grammar.Let Lets, Body);
  syntax LetBinding = "let" Name:Identifier "=" Value:Value ";"  lowers Grammar.LetBinding(text Name, Value);
  syntax Symbols        = "symbols" "{" Kinds:Word+ "}"  lowers Grammar.Symbols(sequence Core.Text Kinds);
  syntax Word           = Value:Identifier  lowers text Core.Text Value;
  syntax Builtin        = "builtin" SymbolKind:Identifier Within:InKind? "{" Names:BuiltinName+ "}"
                          lowers Grammar.Builtin(text SymbolKind, optional Core.Text Within, sequence Core.Text Names);
  syntax BuiltinName    = Value:QualifiedName  lowers text Core.Text Value;
  syntax InKind         = "in" Name:Identifier  lowers text Core.Text Name;
  syntax Using          = "using" Module:QualifiedName ";"  references? module Module  lowers Grammar.Using(text Module);
  syntax TokenRule      = "token" Name:Identifier "=" Body:Expression Except:ExceptList? ";"  declares rule Name
                          lowers Grammar.TokenRule(text Name, Body, optional Grammar.Except Except);
  syntax ExceptList     = "except" Words:ExceptWord+  lowers Grammar.Except(sequence Core.Text Words);
  syntax ExceptWord     = Value:String  lowers text Core.Text Value;
  syntax SyntaxRule     = "syntax" Name:Identifier "=" Body:Expression Clauses:Clause* End:(Terminator / RuleSemantics)  declares rule Name scope
                          lowers Grammar.SyntaxRule(text Name, Body, sequence Grammar.Clause Clauses, End);
  syntax Terminator     = ";"  lowers Grammar.Terminator();
  syntax RuleSemantics  = Block:Semantics  lowers Grammar.RuleSemantics(Block);
  syntax ExtensibleRule = "extensible" "syntax" Name:Identifier "{" Properties:PropertyDecl* Alternatives:Alternative* "}"  declares rule Name scope
                          lowers Grammar.ExtensibleRule(text Name, sequence Grammar.SemanticItem Properties, sequence Grammar.Alternative Alternatives);
  syntax Extend         = "extend" "syntax" Target:QualifiedName "{" Alternatives:Alternative* "}"  references? rule Target
                          lowers Grammar.Extend(text Target, sequence Grammar.Alternative Alternatives);
  // `transparent` (compact trees): the alternative has no node; its one element's node stands in for it.
  syntax Alternative    = "|" Transparent:TransparentWord? Named:AlternativeName? Body:Expression Precedence:PrecedenceSpec? Clauses:Clause* Semantics:Semantics?
                          lowers Grammar.Alternative(optional Core.Text Named, Body, optional Grammar.Precedence Precedence,
                            sequence Grammar.Clause Clauses, optional Grammar.Semantics Semantics, optional Core.Text Transparent);
  // As in the bootstrap parser, `transparent` is a reference unless a name or an element follows it.
  syntax TransparentWord = "transparent" &(Identifier "=" / Element)  lowers text Core.Text this;
  syntax AlternativeName = Name:Identifier "="  lowers text Core.Text Name;
  syntax PrecedenceSpec = "precedence" Level:Integer Associativity:Associativity?
                          lowers Grammar.Precedence(text Level, optional Core.Text Associativity);
  syntax Associativity  = "left" / "right"  lowers text Core.Text this;

  // Binding clauses (issue 237).
  syntax Clause         = Declares / References / ScopeClause / DynamicClause / Lowers / Rewrites / HelperRewrite;
  syntax HelperRewrite = "rewrites" Name:QualifiedName "(" Arguments:(HelperArgument; ",")* ")"
                       lowers Grammar.HelperRewrite(text Name, sequence Core.Text Arguments);
  syntax Rewrites       = "rewrites" Text:TemplateString  lowers Grammar.Rewrites(text Text);
  syntax Declares       = "declares" SymbolKind:Identifier Field:Identifier Sequential:"sequential"? FileScope:("in" "file")? Export:"export"? Type:DeclaredType?
                          lowers Grammar.Declares(text SymbolKind, text Field, optional text Sequential, optional text FileScope,
                            optional text Export, optional Core.Text Type);
  syntax DeclaredType   = "type" Name:QualifiedName  lowers text Core.Text Name;
  syntax References     = "references" Question:"?"? Kinds:KindList Field:Identifier Within:InKind?
                          lowers Grammar.References(optional text Question, Kinds, text Field, optional Core.Text Within);
  syntax KindList       = KindGroup / SingleKind;
  syntax KindGroup      = "(" Kinds:(Word; "|")+ ")"  lowers Grammar.KindGroup(sequence Core.Text Kinds);
  syntax SingleKind     = Name:Identifier  lowers Grammar.SingleKind(text Name);
  syntax ScopeClause    = "scope"  lowers Grammar.Scope();
  syntax DynamicClause  = "dynamic"  lowers Grammar.Dynamic();

  // Declarative typing and lowering (issue 251).
  syntax Lowers         = "lowers" Form:(LowersLiteral / LowersText / LowersSequence / LowersValue / LowersReference / LowersRepeat / LowersTemplate / LowersExpand / LowersCall)
                          lowers Grammar.Lowers(Form);
  syntax LowersTemplate = "template" Field:Identifier "(" Parameters:Identifier Close:")"  lowers Grammar.LowersTemplate(text Field, text Parameters);
  syntax LowersExpand   = "expand" Field:Identifier "(" Arguments:Identifier Close:")"  lowers Grammar.LowersExpand(text Field, text Arguments);
  syntax LowersRepeat   = "repeat" Type:QualifiedName Count:Identifier Iterator:Identifier Children:Identifier
                          lowers Grammar.LowersRepeat(text Type, text Count, text Iterator, text Children);
  syntax LowersLiteral  = "literal" Type:QualifiedName Field:Identifier  lowers Grammar.LowersLiteral(text Type, text Field);
  syntax LowersText     = "text" Type:QualifiedName Field:Identifier  lowers Grammar.LowersText(text Type, text Field);
  syntax LowersSequence = "sequence" Type:QualifiedName Field:Identifier  lowers Grammar.LowersSequence(text Type, text Field);
  syntax LowersValue    = "value" Type:(ComputedType / FixedType) Field:Identifier  lowers Grammar.LowersValue(Type, text Field);
  syntax ComputedType   = "type" Property:Identifier  lowers Grammar.ComputedType(text Property);
  syntax FixedType      = Name:QualifiedName  lowers Grammar.FixedType(text Name);
  syntax LowersReference = "reference" "type" Property:PropertyReference Initializer:InitializerSpec?
                          lowers Grammar.LowersReference(text Property, optional Core.Text Initializer);
  syntax InitializerSpec = "initializer" Name:PropertyReference  lowers text Core.Text Name;
  syntax PropertyReference = Name:Identifier  references? property Name  lowers text Core.Text Name;
  syntax LowersCall     = Operation:(ComputedOperation / FixedOperation) "(" Arguments:(LowersArgument; ",")* Close:")"
                          lowers Grammar.LowersCall(Operation, sequence Grammar.LoweringArgument Arguments);
  syntax ComputedOperation = "operation" Question:"?"? Property:Identifier  lowers Grammar.ComputedOperation(optional text Question, text Property);
  syntax FixedOperation = Name:QualifiedName  lowers Grammar.FixedOperation(text Name);
  syntax LowersArgument = LowersSequenceArgument / LowersOptionalTextArgument / LowersOptionalArgument / LowersTextArgument / FieldArgument;
  syntax LowersSequenceArgument = "sequence" Type:QualifiedName Field:Identifier  lowers Grammar.SequenceArgument(text Type, text Field);
  syntax LowersOptionalTextArgument = "optional" "text" Field:Identifier  lowers Grammar.OptionalTextArgument(text Field);
  syntax LowersOptionalArgument = "optional" Type:QualifiedName Field:Identifier  lowers Grammar.OptionalArgument(text Type, text Field);
  syntax LowersTextArgument = "text" Field:Identifier  lowers Grammar.TextArgument(text Field);
  syntax FieldArgument  = Field:Identifier  lowers Grammar.FieldArgument(text Field);

  // Semantics (issue 239).
  syntax SymbolProperty = "symbol" "property" Name:Identifier "for" Kinds:KindList ":" Type:CsType "=" Default:CsCode ";"  declares property Name
                          lowers Grammar.SymbolProperty(text Name, Kinds, text Type, text Default);
  syntax Semantics      = "{" Items:SemanticItem* "}"  lowers Grammar.Semantics(sequence Grammar.SemanticItem Items);
  syntax SemanticItem   = PropertyDecl / Check / MatchDiagnostic / Assignment;
  syntax PropertyDecl   = Direction:("out" / "in") Flags:PropertyFlag* Name:Identifier ":" Type:CsType "=" Default:CsCode ";"  declares property Name
                          lowers Grammar.PropertyDecl(text Direction, sequence Core.Text Flags, text Name, text Type, text Default);
  syntax PropertyFlag   = "hover" / "expected"  lowers text Core.Text this;
  syntax Check          = "check" Code:CheckCode? Condition:CsCond ":" Message:CsMessage At:CheckAt? ";"
                          lowers Grammar.Check(optional text Code, text Condition, text Message, optional Core.Text At);
  syntax CheckAt        = "at" Name:Identifier  lowers text Core.Text Name;
  syntax MatchDiagnostic = "match" Captures:QuoteCaptures? Pattern:TemplateString Context:MatchContext? "=>" Severity:("warning" / "error") Code:CheckCode ":" Message:CsCode ";"
                          lowers Grammar.MatchDiagnostic(optional Grammar.QuoteCaptures Captures, text Pattern, text Severity, text Code, text Message, optional Grammar.MatchContext Context);
  syntax MatchContext   = Kind:("inside" / "parent") Category:QualifiedName? Captures:QuoteCaptures? Pattern:TemplateString
                          lowers Grammar.MatchContext(text Kind, optional text Category, optional Grammar.QuoteCaptures Captures, text Pattern);
  syntax Assignment     = Target:QualifiedName "=" Value:CsCode ";"  references? property Target  lowers Grammar.Assignment(text Target, text Value);

  syntax Expression     = Choices:(Sequence; "/")+  lowers Grammar.Choice(sequence Grammar.Expression Choices);
  syntax Sequence       = Elements:Element+  lowers Grammar.Sequence(sequence Grammar.Expression Elements);
  syntax Element        = Label:LabelPrefix? Body:Unary  lowers Grammar.Element(optional Core.Text Label, Body);
  syntax LabelPrefix    = Name:Identifier ":"  lowers text Core.Text Name;
  syntax Unary          = Prefixes:PredicateOp* Body:Postfix  lowers Grammar.Unary(sequence Core.Text Prefixes, Body);
  syntax PredicateOp    = "!" / "&"  lowers text Core.Text this;
  syntax Postfix        = Body:Primary Operators:RepeatOp*  lowers Grammar.Postfix(Body, sequence Core.Text Operators);
  syntax RepeatOp       = "?" / "*" / "+"  lowers text Core.Text this;
  syntax Primary        = Conditional / Comprehension / Call / EmptyGroup / StringLiteral / CharClass / Any / Parenthesized / Reference;
  syntax Conditional    = "if" Condition:Value "then" Then:Expression "else" Else:Expression  lowers Grammar.If(Condition, Then, Else);
  syntax Comprehension  = Kind:("choice" / "seq") Variable:Identifier "in" From:Value To:RangeTo? Block:Block
                          lowers Grammar.Comprehension(text Kind, text Variable, From, optional Grammar.Value To, Block);
  syntax RangeTo        = ".." Bound:Value  lowers Grammar.RangeTo(Bound);
  syntax Block          = "{" Lets:LetBinding* Where:WhereClause? Body:Expression "}"  lowers Grammar.Block(sequence Grammar.Let Lets, optional Grammar.Value Where, Body);
  syntax WhereClause    = "where" Condition:Value ":"  lowers Grammar.Where(Condition);
  syntax Call           = Head:CallHead Arguments:(Value; ",")* ")"  lowers Grammar.Call(text Head, sequence Grammar.Value Arguments);
  syntax EmptyGroup     = "(" ")"  lowers Grammar.Empty();
  syntax StringLiteral  = Value:String  lowers Grammar.Literal(text Value);
  syntax Any            = "."  lowers Grammar.Any();
  syntax Parenthesized  = "(" Inner:Expression Tail:(SeparatorTail / GroupClose)  lowers Grammar.Parenthesized(Inner, Tail);
  syntax SeparatorTail  = ";" Separator:Expression ")" Op:("*" / "+")  lowers Grammar.SeparatorTail(Separator, text Op);
  syntax GroupClose     = ")"  lowers Grammar.GroupClose();
  syntax Reference      = !"precedence" !"except" !"then" !"else" !"declares" !"references" !"scope" !"dynamic" !"lowers" !"rewrites" Name:QualifiedName  references? rule Name
                          lowers Grammar.Reference(text Name);
  syntax QualifiedName  = DottedName / Identifier;
  syntax CharClass      = "[" Negated:"^"? Items:ClassItem+ "]"  lowers Grammar.CharClass(optional text Negated, sequence Grammar.ClassItem Items);
  syntax ClassItem      = First:ClassBound Last:RangeEnd?  lowers Grammar.ClassItem(First, optional Grammar.Value Last);
  syntax RangeEnd       = ".." Last:ClassBound  lowers Grammar.RangeTo(Last);
  syntax ClassBound     = CharValue / ValueCall / NameValue / ValueGroup;

  // Value expressions of grammar functions, loosest first.
  syntax Value          = IfValue / OrValue;
  syntax IfValue        = "if" Condition:Value "then" Then:Value "else" Else:Value  lowers Grammar.IfValue(Condition, Then, Else);
  syntax OrValue        = First:AndValue Rest:OrTail*  lowers Grammar.Chain(First, sequence Grammar.ChainTail Rest);
  syntax OrTail         = Op:"or" Operand:AndValue  lowers Grammar.ChainTail(text Op, Operand);
  syntax AndValue       = First:NotValue Rest:AndTail*  lowers Grammar.Chain(First, sequence Grammar.ChainTail Rest);
  syntax AndTail        = Op:"and" Operand:NotValue  lowers Grammar.ChainTail(text Op, Operand);
  syntax NotValue       = NotPrefix / CompareValue;
  syntax NotPrefix      = Op:"not" Operand:NotValue  lowers Grammar.UnaryValue(text Op, Operand);
  syntax CompareValue   = First:UnionValue Rest:CompareTail?  lowers Grammar.Single(First, optional Grammar.ChainTail Rest);
  syntax CompareTail    = Op:("==" / "!=" / "<=" / ">=" / "<" / ">") Operand:UnionValue  lowers Grammar.ChainTail(text Op, Operand);
  syntax UnionValue     = First:InterValue Rest:UnionTail*  lowers Grammar.Chain(First, sequence Grammar.ChainTail Rest);
  syntax UnionTail      = Op:"|" Operand:InterValue  lowers Grammar.ChainTail(text Op, Operand);
  syntax InterValue     = First:SumValue Rest:InterTail*  lowers Grammar.Chain(First, sequence Grammar.ChainTail Rest);
  syntax InterTail      = Op:"&" Operand:SumValue  lowers Grammar.ChainTail(text Op, Operand);
  syntax SumValue       = First:ProductValue Rest:SumTail*  lowers Grammar.Chain(First, sequence Grammar.ChainTail Rest);
  syntax SumTail        = Op:("+" / "-") Operand:ProductValue  lowers Grammar.ChainTail(text Op, Operand);
  syntax ProductValue   = First:PowerValue Rest:ProductTail*  lowers Grammar.Chain(First, sequence Grammar.ChainTail Rest);
  syntax ProductTail    = Op:("*" / "/" / "%") Operand:PowerValue  lowers Grammar.ChainTail(text Op, Operand);
  syntax PowerValue     = First:UnaryValue Rest:PowerTail?  lowers Grammar.Single(First, optional Grammar.ChainTail Rest);
  syntax PowerTail      = Op:"^" Operand:PowerValue  lowers Grammar.ChainTail(text Op, Operand);
  syntax UnaryValue     = UnaryPrefix / AtomValue;
  syntax UnaryPrefix    = Op:("-" / "~") Operand:UnaryValue  lowers Grammar.UnaryValue(text Op, Operand);
  syntax AtomValue      = IntValue / CharValue / TextValue / ClassValue / BlockValue / ValueCall / NameValue / ValueGroup;
  syntax IntValue       = Value:Integer  lowers Grammar.IntValue(text Value);
  syntax CharValue      = Value:Char  lowers Grammar.CharValue(text Value);
  syntax TextValue      = Value:String  lowers Grammar.TextValue(text Value);
  syntax ClassValue     = "[" Negated:"^"? Items:ClassItem* "]"  lowers Grammar.ClassValue(optional text Negated, sequence Grammar.ClassItem Items);
  syntax BlockValue     = Block:Block  lowers Grammar.BlockValue(Block);
  syntax ValueCall      = Head:CallHead Arguments:(Value; ",")* ")"  lowers Grammar.ValueCall(text Head, sequence Grammar.Value Arguments);
  syntax NameValue      = !"or" !"and" !"not" !"if" !"then" !"else" Name:QualifiedName  lowers Grammar.Name(text Name);
  syntax ValueGroup     = "(" Inner:Value ")"  lowers Grammar.ValueGroup(Inner);
}
